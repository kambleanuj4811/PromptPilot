# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER commit .env and NEVER paste your key into chat or source code.

# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ID is configurable. Suggested default (stable, free-tier eligible per
# Google's docs as of Oct 2026): gemini-3.1-flash-lite
# Verify availability for YOUR key with: python scripts/check_env.py
GEMINI_MODEL=gemini-3.1-flash-lite

# Local storage (relative to the project root)
DATABASE_URL=sqlite:///./backend/data/promptpilot.db
CHROMA_PERSIST_DIRECTORY=./backend/data/chroma
UPLOAD_DIRECTORY=./backend/uploads
MAX_UPLOAD_SIZE_MB=20

# Local embedding model (downloaded once from Hugging Face, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Allowed CORS origin (Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173
